DEEPGRAM_API_KEY=your_deepgram_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Any OpenAI-compatible endpoint (LM Studio, vLLM, llama.cpp server, Together, Azure OpenAI, ...)
# Set LLM_PROVIDER=openai-compatible and point OPENAI_BASE_URL at the API root.
# The app appends /chat/completions unless the URL already ends with it.
OPENAI_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
